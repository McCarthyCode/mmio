# Environment Configuration
# Copy this file to .env and update with appropriate values for your environment

# Application Environment (DEVELOPMENT, STAGING, or PRODUCTION)
ENVIRONMENT=DEVELOPMENT

# Application Settings
APP_DEBUG=false
APP_PORT=8080
APP_WORKERS=4

# Logging
LOG_LEVEL=INFO

# Nginx Settings
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024

# Security Headers
CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'nonce-{NONCE}' cdn.jsdelivr.net; style-src 'self' fonts.googleapis.com; font-src 'self' fonts.gstatic.com; img-src 'self' data:; connect-src 'self' cdn.jsdelivr.net; frame-ancestors 'none';"

# Database (for future use)
# DATABASE_URL=

# API Keys (for future use)
# API_KEY=
# ANALYTICS_KEY=

# Feature Flags (for future use)
# FEATURE_LAMBDA_DEPLOYMENT=false
# FEATURE_STAGING_ENVIRONMENT=false
